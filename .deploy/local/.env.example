# Copy this file to .env and replace every change-me value before deployment.
COMPOSE_PROJECT_NAME=openchat-wx
REDIS_PASSWORD=change-me-redis
MYSQL_ROOT_PASSWORD=change-me-mysql-root
MYSQL_USER_PASSWORD=change-me-mysql-user
QDRANT_API_KEY=change-me-qdrant
SESSION_SECRET=change-me-session-secret
LOGIN_TOKEN=change-me-login-token
WECHAT_SERVER_TOKEN=change-me-wechat-server-token
THIRD_PARTY_API_KEY=change-me-third-party-api-key

# Obtain a valid slider token from the protocol provider. Never commit it.
SLIDER_TOKEN=

# Optional services.
OPENAI_API_KEY=
MUSIC_U=
WECHAT_OFFICIAL_ACCOUNT_AUTH_URL=https://img.houhoukang.com/uranus/qrcode_for_gh.jpg

# Optional image registry mirror, for example docker.m.daocloud.io/library.
REGISTRY=docker.io
